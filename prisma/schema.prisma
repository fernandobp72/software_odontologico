generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PayMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  OTHER
}

enum Role {
  ADMIN
  DENTIST
  RECEPTION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

// Estado de una superficie/diente en el odontograma (FDI)
enum ToothCondition {
  HEALTHY
  CARIES
  FILLING
  CROWN
  ROOT_CANAL
  EXTRACTED
  MISSING
  IMPLANT
  SEALANT
  FRACTURE
  CARIES_ENAMEL
  IMPACTED
  PARTIAL
}

enum PlanStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ItemStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

model Clinic {
  requireSello        Boolean           @default(false) // exige firmar con el sello digital del profesional
  id                  String            @id @default(cuid())
  name                String
  nit                 String?
  address             String?
  phone               String?
  // ACTIVE | TRIAL | SUSPENDED. Lo cambia el dueño de la plataforma.
  status              String            @default("ACTIVE")
  // Consultorio interno que solo guarda la cuenta del dueño de la plataforma: no es un cliente y no tiene pacientes.
  system              Boolean           @default(false)
  // Cómo llama la organización a su centro en la interfaz: consultorio | clinica | centro
  noun                String            @default("consultorio")
  // Logo ya optimizado por el servidor (WebP, máximo 512 px). Se sirve en /api/logo/<id>
  logo                Bytes?
  logoUpdatedAt       DateTime?
  // Color de fondo del ícono de la app instalada (#RRGGBB). Sin color: blanco si hay logo, verde con un diente si no.
  iconColor           String?
  // Ícono propio de la app instalada (opcional). Si no hay, el ícono se arma con el logo.
  appIcon             Bytes?
  appIconUpdatedAt    DateTime?
  // WhatsApp Business propio del consultorio (API de Meta). El token se guarda cifrado.
  whatsappPhoneId     String?
  whatsappToken       String?
  whatsappTemplate    String?
  whatsappLang        String?
  whatsappAuto        Boolean           @default(false)
  whatsappButtons     Boolean           @default(false) // plantilla con botones Confirmar / No podré asistir (respuestas por webhook)
  whatsappAppSecret   String? // secreto de la app de Meta (cifrado) para validar el webhook
  whatsappVerifyToken String? // clave que Meta devuelve al verificar el webhook
  trialEndsAt         DateTime?
  termsAcceptedAt     DateTime?
  termsVersion        String?
  createdAt           DateTime          @default(now())
  users               User[]
  patients            Patient[]
  appointments        Appointment[]
  cashSessions        CashSession[]
  payments            Payment[]
  invoices            Invoice[]
  invitations         Invitation[]
  branches            Branch[]
  clinicProcedures    ClinicProcedure[]
  prescriptions       Prescription[]
}

model User {
  id                  String               @id @default(cuid())
  clinicId            String
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  email               String               @unique
  passwordHash        String
  name                String
  role                Role
  // Registro profesional (RETHUS / tarjeta profesional) requerido para firmar evoluciones
  licenseNumber       String?
  phone               String?
  active              Boolean              @default(true)
  isPlatformAdmin     Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  appointments        Appointment[]
  evolutions          Evolution[]
  auditLogs           AuditLog[]
  assessments         Assessment[]
  diagnoses           Diagnosis[]
  plans               TreatmentPlan[]
  consents            Consent[]
  odontogramSnapshots OdontogramSnapshot[]
  perioExams          PerioExam[]
  cashSessions        CashSession[]
  payments            Payment[]
  clinicalImages      ClinicalImage[]
  invoices            Invoice[]
  invitations         Invitation[]
  prescriptions       Prescription[]
  passwordResets      PasswordReset[]
  userBranches        UserBranch[]
  // Sello digital del profesional: cuántas veces se le ha reexpedido tras perder todos sus dispositivos.
  sealGeneration      Int                  @default(0)
  signingCredentials  SigningCredential[]
  signingGrants       SigningGrant[]       @relation("GrantFor")
  proSignatures       ProSignature[]
}

// Cada dispositivo o llave con que un profesional puede firmar (como un sello físico: puede tener varios y se reporta si se pierde).
model SigningCredential {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  serial           Int // número del sello dentro del profesional (1, 2, 3…)
  generation       Int            @default(0) // reexpedición del sello a la que pertenece
  kind             String // PASSKEY | PIN
  label            String
  credentialId     String?        @unique
  publicKey        Bytes?
  counter          Int            @default(0)
  transports       String?
  deviceType       String?
  backedUp         Boolean        @default(false)
  pinHash          String?
  pinFailures      Int            @default(0)
  pinLockedUntil   DateTime?
  createdAt        DateTime       @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokedReason    String? // LOST | CHANGED | ADMIN
  revokedById      String?
  compromisedSince DateTime? // desde cuándo se sospecha que otra persona pudo usarlo
  signatures       ProSignature[]

  @@unique([userId, serial])
  @@index([userId])
}

// Reto de un solo uso para registrar o firmar con un dispositivo.
model SigningChallenge {
  id          String    @id @default(cuid())
  userId      String
  purpose     String // REGISTER | SIGN
  challenge   String // lo que firma el dispositivo (base64url)
  contentHash String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Autorización del administrador para que el profesional obtenga un sello nuevo cuando perdió todos los anteriores.
model SigningGrant {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("GrantFor", fields: [userId], references: [id])
  createdById String
  createdAt   DateTime  @default(now())
  startsAt    DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  @@index([userId])
}

// Firma de un profesional sobre un documento: quién, con qué credencial, qué contenido (hash) y la prueba criptográfica.
model ProSignature {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  credentialId String?
  credential   SigningCredential? @relation(fields: [credentialId], references: [id])
  docKind      String // Evolution | Prescription
  docId        String
  method       String // PASSKEY | PIN | SESSION
  contentHash  String
  assertion    Json?
  generation   Int                @default(0)
  ip           String?
  agent        String?
  signedAt     DateTime           @default(now())

  @@unique([docKind, docId])
  @@index([userId])
}

model Patient {
  id                   String                @id @default(cuid())
  clinicId             String
  clinic               Clinic                @relation(fields: [clinicId], references: [id])
  documentType         String                @default("CC") // CC, TI, CE, RC, PA, PT
  documentNumber       String
  firstName            String
  middleName           String?
  lastName             String
  secondLastName       String?
  birthDate            DateTime?
  sex                  String?
  phone                String?
  email                String?
  address              String?
  city                 String?
  eps                  String?
  regime               String? // CONTRIBUTIVO, SUBSIDIADO, PARTICULAR
  occupation           String?
  companionName        String?
  companionPhone       String?
  companionKin         String?
  allergies            String?
  medicalHistory       String?
  // Habeas data (Ley 1581 de 2012)
  dataConsentAt        DateTime?
  // Autorización expresa para recordatorios por WhatsApp (Ley 1581 de 2012)
  whatsappOptInAt      DateTime?
  // Cuándo se generaron automáticamente los diagnósticos y el plan a partir de los hallazgos
  autoPlanAt           DateTime?
  createdAt            DateTime              @default(now())
  appointments         Appointment[]
  evolutions           Evolution[]
  toothFindings        ToothFinding[]
  assessments          Assessment[]
  diagnoses            Diagnosis[]
  plans                TreatmentPlan[]
  consents             Consent[]
  snapshots            OdontogramSnapshot[]
  perioExams           PerioExam[]
  payments             Payment[]
  clinicalImages       ClinicalImage[]
  invoices             Invoice[]
  dismissedSuggestions DismissedSuggestion[]
  intakeForms          IntakeForm[]
  prescriptions        Prescription[]

  @@unique([clinicId, documentType, documentNumber])
  @@index([clinicId, lastName])
}

model Appointment {
  id           String            @id @default(cuid())
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  dentistId    String
  dentist      User              @relation(fields: [dentistId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  status       AppointmentStatus @default(SCHEDULED)
  confirmToken String?           @unique
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  reminders    Reminder[]
  createdAt    DateTime          @default(now())

  @@index([clinicId, startsAt])
  @@index([branchId, startsAt])
  @@index([dentistId, startsAt])
}

// Evolución clínica. Una vez firmada es inmutable (Res. 1995/1999): las correcciones
// se registran como una nueva evolución que referencia a la anterior.
model Evolution {
  id            String      @id @default(cuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  dentistId     String
  dentist       User        @relation(fields: [dentistId], references: [id])
  reason        String? // motivo de consulta
  diagnosisCode String? // CIE-10
  procedureCode String? // CUPS
  note          String // descripción del procedimiento / evolución
  signedAt      DateTime    @default(now())
  seal          String?     @unique // sello de integridad (HMAC) calculado al firmar
  correctsId    String?
  corrects      Evolution?  @relation("Correction", fields: [correctsId], references: [id])
  corrections   Evolution[] @relation("Correction")
  createdAt     DateTime    @default(now())

  @@index([patientId, signedAt])
}

model ToothFinding {
  id        String         @id @default(cuid())
  patientId String
  patient   Patient        @relation(fields: [patientId], references: [id])
  tooth     Int // numeración FDI: 11-18, 21-28, 31-38, 41-48 (51-85 temporales)
  surface   String? // M, D, O, V, L o null = diente completo
  condition ToothCondition
  note      String?
  createdAt DateTime       @default(now())

  @@index([patientId, tooth])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  // Texto legible para el registro de actividad de la plataforma (qué cliente o persona)
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Valoración clínica (anamnesis + examen). Solo se agregan versiones; la última es la vigente.
model Assessment {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  data      Json
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

model Diagnosis {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])
  dentistId   String
  dentist     User            @relation(fields: [dentistId], references: [id])
  code        String // CIE-10
  description String
  tooth       Int?
  // Si lo propuso el sistema a partir de un hallazgo: clave estable para no duplicar
  sourceKey   String?
  note        String?
  status      DiagnosisStatus @default(ACTIVE)
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([patientId, status])
}

model TreatmentPlan {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])
  dentistId   String
  dentist     User            @relation(fields: [dentistId], references: [id])
  title       String
  status      PlanStatus      @default(DRAFT)
  presentedAt DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime        @default(now())
  items       TreatmentItem[]

  @@index([patientId, status])
}

model TreatmentItem {
  id            String        @id @default(cuid())
  planId        String
  plan          TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  phase         Int // 1 urgencia, 2 control de la enfermedad, 3 rehabilitación, 4 mantenimiento
  tooth         Int?
  surfaces      String?
  procedureCode String? // CUPS, solo si está verificado
  name          String
  quantity      Int           @default(1)
  unitPrice     Int           @default(0) // COP
  status        ItemStatus    @default(PLANNED)
  doneAt        DateTime?
  doneById      String?
  evolutionId   String?
  notes         String?
  sourceKey     String?
  material      String?
  createdAt     DateTime      @default(now())

  @@index([planId, phase])
}

// Consentimiento informado firmado. Inmutable: guarda el texto exacto que se firmó.
model Consent {
  id               String    @id @default(cuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  dentistId        String
  dentist          User      @relation(fields: [dentistId], references: [id])
  templateId       String
  templateVersion  String
  title            String
  body             String
  procedureNote    String?
  signerName       String
  signerDocument   String?
  signerRelation   String
  witnessName      String?
  signature        String // PNG en data URL
  signedAt         DateTime  @default(now())
  seal             String?   @unique // sello de integridad (HMAC) calculado al firmar
  // Firma hecha por el paciente en su propio celular (QR o enlace). Vacíos si se firmó en el aparato del consultorio.
  signMethod       String? // QR | ENLACE
  signIp           String?
  signAgent        String?
  requestId        String?   @unique
  // Huella del aparato (cookie propia, solo su hash) y segundos entre abrir el documento y firmar: sirven para detectar firmas dudosas.
  signDevice       String?
  signReadSec      Int?
  // Constancia para el paciente: enlace secreto (solo su huella) que muestra el documento firmado; vence y se bloquea tras 5 fallos.
  receiptTokenHash String?   @unique
  receiptExpiresAt DateTime?
  receiptFailures  Int       @default(0)
  receiptSentAt    DateTime?
  receiptSentTo    String?

  @@index([patientId, signedAt])
}

// Solicitud para que el paciente firme un consentimiento desde su celular. Guarda el texto exacto que verá; el enlace es secreto
// (solo se guarda su huella), vence y se bloquea tras 5 intentos fallidos con el documento.
model ConsentRequest {
  id              String    @id @default(cuid())
  clinicId        String
  patientId       String
  dentistId       String
  templateId      String
  templateVersion String
  title           String
  body            String
  procedureNote   String?
  signerName      String
  signerDocument  String? // sus últimos 4 dígitos son la clave de acceso
  signerRelation  String
  method          String // QR | ENLACE
  tokenHash       String    @unique
  expiresAt       DateTime
  failures        Int       @default(0)
  unlockedAt      DateTime? // cuándo el paciente escribió los 4 dígitos y vio el documento
  consentId       String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([patientId, createdAt])
}

// Foto fija del odontograma (p. ej. el inicial, que no cambia después).
model OdontogramSnapshot {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  kind      String // INITIAL
  data      Json
  createdAt DateTime @default(now())

  @@unique([patientId, kind])
}

// Periodontograma. Solo se agregan versiones; la última es la vigente.
model PerioExam {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  data      Json // por diente: sitios con sondaje, margen, sangrado, placa; movilidad, furca
  summary   Json
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

// Sesión de caja: una abierta a la vez por consultorio.
model CashSession {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  openedById    String
  openedBy      User      @relation(fields: [openedById], references: [id])
  openedAt      DateTime  @default(now())
  openingAmount Int       @default(0)
  closedAt      DateTime?
  closedById    String?
  countedCash   Int?
  expectedCash  Int?
  difference    Int?
  note          String?
  payments      Payment[]

  @@index([clinicId, openedAt])
}

// Pago recibido. Inmutable: los errores se corrigen anulando con motivo.
model Payment {
  id             String      @id @default(cuid())
  clinicId       String
  clinic         Clinic      @relation(fields: [clinicId], references: [id])
  number         Int // consecutivo del recibo por consultorio
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id])
  sessionId      String
  session        CashSession @relation(fields: [sessionId], references: [id])
  amount         Int // COP
  method         PayMethod
  reference      String?
  note           String?
  receivedById   String
  receivedBy     User        @relation(fields: [receivedById], references: [id])
  receivedAt     DateTime    @default(now())
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  // Enlace público para compartir el recibo por correo o WhatsApp: solo se guarda el hash; vence a los 30 días.
  shareTokenHash String?     @unique
  shareExpiresAt DateTime?
  // Protección del enlace: intentos fallidos de documento (se bloquea a los 5) y aperturas del día (tope diario).
  shareFailures  Int         @default(0)
  shareOpens     Int         @default(0)
  shareOpensDay  String?

  @@unique([clinicId, number])
  @@index([patientId])
  @@index([sessionId])
}

// Intento de recordatorio por WhatsApp. channel: MANUAL (enlace wa.me) o CLOUD (API de Meta).
model Reminder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       String
  status        String // SENT | FAILED
  error         String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

// Radiografía, fotografía o documento clínico. Se guarda en la base de datos para que quede
// dentro de las copias de seguridad; los archivos no se borran, solo se anulan con motivo.
model ClinicalImage {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id])
  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])
  kind            String
  tooth           Int?
  takenAt         DateTime
  note            String?
  fileName        String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  data            Bytes
  thumb           Bytes?
  interpretation  String?
  interpretedById String?
  interpretedAt   DateTime?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime  @default(now())

  @@index([patientId, takenAt])
}

// Cuenta de cobro: documento interno numerado con los procedimientos realizados.
// NO es factura electrónica de venta; esa se emite con un proveedor tecnológico autorizado.
model Invoice {
  id               String        @id @default(cuid())
  clinicId         String
  clinic           Clinic        @relation(fields: [clinicId], references: [id])
  number           Int
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id])
  customerName     String
  customerDocument String?
  issuedAt         DateTime      @default(now())
  total            Int
  note             String?
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id])
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  lines            InvoiceLine[]

  @@unique([clinicId, number])
  @@index([patientId])
}

model InvoiceLine {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Un procedimiento solo puede estar en una cuenta vigente; al anular la cuenta se libera.
  itemId        String? @unique
  description   String
  tooth         Int?
  procedureCode String?
  quantity      Int
  unitPrice     Int
}

// Invitación para unirse a un consultorio. Se guarda solo el hash del enlace.
model Invitation {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  email       String
  role        Role
  tokenHash   String    @unique
  branchIds   String[]
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([clinicId])
}

// Enlace de un solo uso para definir una contraseña nueva.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Sede de un consultorio. Los pacientes son del consultorio; agenda y caja son por sede.
model Branch {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  name         String
  address      String?
  phone        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  users        UserBranch[]
  appointments Appointment[]
  cashSessions CashSession[]

  @@index([clinicId])
}

// Sedes a las que puede entrar una persona (los administradores entran a todas).
model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

// Sugerencias que el odontólogo eliminó: la sincronización automática no las vuelve a agregar.
model DismissedSuggestion {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  key       String
  createdAt DateTime @default(now())

  @@unique([patientId, key])
}

// Catálogo de cada consultorio: qué procedimientos ofrece, con qué materiales y a qué tarifa.
model ClinicProcedure {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  procId    String // id del catálogo base o "custom-..." si lo creó el consultorio
  name      String
  cups      String?
  group     String
  scope     String // mouth | quadrant | tooth | surface
  active    Boolean  @default(true)
  price     Int      @default(0) // COP, tarifa base
  // [{ name, price, isDefault }]: si el material tiene precio, reemplaza a la tarifa base
  materials Json     @default("[]")
  createdAt DateTime @default(now())

  @@unique([clinicId, procId])
}

// Inventario de insumos. El producto es del consultorio; las existencias (lotes) son de cada sede.
model SupplyItem {
  id         String           @id @default(cuid())
  clinicId   String
  name       String
  category   String
  unit       String // caja, tubo, frasco, unidad…
  perishable Boolean          @default(true) // si vence, el ingreso exige fecha de vencimiento
  minStock   Int              @default(0) // por debajo de este nivel el semáforo queda en rojo
  warnDays   Int              @default(60) // días antes del vencimiento en que pasa a amarillo
  active     Boolean          @default(true)
  catalogKey String? // clave del catálogo precargado, si salió de ahí
  // Las existencias se cuentan en la unidad de uso (carpule, par, aplicación…). Si viene empacado, packLabel/packSize
  // permiten ingresar «2 cajas» y que cuente 100 carpules.
  packLabel  String?
  packSize   Int?
  createdAt  DateTime         @default(now())
  lots       SupplyLot[]
  movements  SupplyMovement[]
  kitLines   SupplyKitLine[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model SupplyLot {
  id          String     @id @default(cuid())
  clinicId    String
  branchId    String
  itemId      String
  item        SupplyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotCode     String?
  quantity    Int // lo que queda
  initialQty  Int
  expiresAt   DateTime?  @db.Date
  receivedAt  DateTime   @default(now())
  createdById String

  @@index([itemId, branchId])
  @@index([clinicId, branchId])
}

// Bitácora de existencias: IN ingreso, OUT consumo, DISCARD descarte de vencidos.
model SupplyMovement {
  id        String     @id @default(cuid())
  clinicId  String
  branchId  String
  itemId    String
  item      SupplyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotId     String?
  kind      String
  delta     Int
  note      String?
  userId    String
  // Si el consumo salió de un procedimiento hecho: «evo:<id>» o «item:<id>». Evita descontar dos veces lo mismo.
  refId     String?
  createdAt DateTime   @default(now())

  @@index([clinicId, branchId, createdAt])
  @@index([itemId])
  @@index([refId])
}

// Kit: lo que gasta un procedimiento del catálogo (procId de ClinicProcedure), en la unidad de uso del insumo.
model SupplyKitLine {
  id       String     @id @default(cuid())
  clinicId String
  procId   String
  itemId   String
  item     SupplyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int

  @@unique([clinicId, procId, itemId])
  @@index([clinicId, procId])
}

// Formulario previo: el paciente llena su anamnesis desde un enlace antes de la cita.
// Solo se guarda el hash del token; el profesional revisa y lo pasa a la valoración.
model IntakeForm {
  id           String    @id @default(cuid())
  clinicId     String
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  createdById  String
  tokenHash    String    @unique
  expiresAt    DateTime
  submittedAt  DateTime?
  data         Json?
  signerName   String?
  signature    String?
  reviewedAt   DateTime?
  reviewedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([patientId, createdAt])
  @@index([clinicId, submittedAt])
}

// Conexión de correo saliente de la plataforma (SMTP). Una sola fila; la contraseña se guarda cifrada.
model EmailConfig {
  id          String   @id @default("main")
  host        String
  port        Int
  secure      Boolean  @default(false)
  username    String?
  passwordEnc String?
  fromName    String
  fromEmail   String
  updatedAt   DateTime @updatedAt
}

// Fórmula médica firmada. Inmutable: las correcciones se hacen anulándola y generando otra.
model Prescription {
  id            String             @id @default(cuid())
  clinicId      String
  clinic        Clinic             @relation(fields: [clinicId], references: [id])
  number        Int // consecutivo por consultorio
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  dentistId     String
  dentist       User               @relation(fields: [dentistId], references: [id])
  issuedAt      DateTime           @default(now())
  diagnosisCode String? // CIE-10
  diagnosisText String?
  weightKg      Float?
  notes         String?
  vademecum     String // versión del vademécum con el que se armó
  seal          String?            @unique // sello de integridad (HMAC) calculado al firmar
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  items         PrescriptionItem[]

  @@unique([clinicId, number])
  @@index([patientId, issuedAt])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  position       Int
  drugId         String? // clave del vademécum; vacío si se escribió a mano
  name           String // denominación común internacional
  concentration  String
  form           String
  route          String
  dose           String
  frequency      String
  duration       String
  quantity       Int
  quantityText   String
  instructions   String?
  alerts         Json? // alertas vigentes al firmar
  override       String? // motivo si el odontólogo firmó pese a una alerta de bloqueo
}

// Presentaciones vigentes del CUM del INVIMA por código ATC, guardadas para no consultar el servicio abierto en cada pantalla.
model InvimaCache {
  atc       String   @id
  rows      Json
  fetchedAt DateTime @default(now())
}
