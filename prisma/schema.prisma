generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PayMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  OTHER
}

enum Role {
  ADMIN
  DENTIST
  RECEPTION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

// Estado de una superficie/diente en el odontograma (FDI)
enum ToothCondition {
  HEALTHY
  CARIES
  FILLING
  CROWN
  ROOT_CANAL
  EXTRACTED
  MISSING
  IMPLANT
  SEALANT
  FRACTURE
  CARIES_ENAMEL
  IMPACTED
  PARTIAL
}

enum PlanStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ItemStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

model Clinic {
  id              String        @id @default(cuid())
  name            String
  nit             String?
  address         String?
  phone           String?
  // ACTIVE | TRIAL | SUSPENDED. Lo cambia el dueño de la plataforma.
  status          String        @default("ACTIVE")
  trialEndsAt     DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime      @default(now())
  users           User[]
  patients        Patient[]
  appointments    Appointment[]
  cashSessions    CashSession[]
  payments        Payment[]
  invoices        Invoice[]
  invitations     Invitation[]
  branches        Branch[]
}

model User {
  id                  String               @id @default(cuid())
  clinicId            String
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  email               String               @unique
  passwordHash        String
  name                String
  role                Role
  // Registro profesional (RETHUS / tarjeta profesional) requerido para firmar evoluciones
  licenseNumber       String?
  active              Boolean              @default(true)
  isPlatformAdmin     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  appointments        Appointment[]
  evolutions          Evolution[]
  auditLogs           AuditLog[]
  assessments         Assessment[]
  diagnoses           Diagnosis[]
  plans               TreatmentPlan[]
  consents            Consent[]
  odontogramSnapshots OdontogramSnapshot[]
  perioExams          PerioExam[]
  cashSessions        CashSession[]
  payments            Payment[]
  clinicalImages      ClinicalImage[]
  invoices            Invoice[]
  invitations         Invitation[]
  passwordResets      PasswordReset[]
  userBranches        UserBranch[]
}

model Patient {
  id                   String                @id @default(cuid())
  clinicId             String
  clinic               Clinic                @relation(fields: [clinicId], references: [id])
  documentType         String                @default("CC") // CC, TI, CE, RC, PA, PT
  documentNumber       String
  firstName            String
  middleName           String?
  lastName             String
  secondLastName       String?
  birthDate            DateTime?
  sex                  String?
  phone                String?
  email                String?
  address              String?
  city                 String?
  eps                  String?
  regime               String? // CONTRIBUTIVO, SUBSIDIADO, PARTICULAR
  occupation           String?
  companionName        String?
  companionPhone       String?
  companionKin         String?
  allergies            String?
  medicalHistory       String?
  // Habeas data (Ley 1581 de 2012)
  dataConsentAt        DateTime?
  // Autorización expresa para recordatorios por WhatsApp (Ley 1581 de 2012)
  whatsappOptInAt      DateTime?
  // Cuándo se generaron automáticamente los diagnósticos y el plan a partir de los hallazgos
  autoPlanAt           DateTime?
  createdAt            DateTime              @default(now())
  appointments         Appointment[]
  evolutions           Evolution[]
  toothFindings        ToothFinding[]
  assessments          Assessment[]
  diagnoses            Diagnosis[]
  plans                TreatmentPlan[]
  consents             Consent[]
  snapshots            OdontogramSnapshot[]
  perioExams           PerioExam[]
  payments             Payment[]
  clinicalImages       ClinicalImage[]
  invoices             Invoice[]
  dismissedSuggestions DismissedSuggestion[]

  @@unique([clinicId, documentType, documentNumber])
  @@index([clinicId, lastName])
}

model Appointment {
  id           String            @id @default(cuid())
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  dentistId    String
  dentist      User              @relation(fields: [dentistId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  status       AppointmentStatus @default(SCHEDULED)
  confirmToken String?           @unique
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  reminders    Reminder[]
  createdAt    DateTime          @default(now())

  @@index([clinicId, startsAt])
  @@index([branchId, startsAt])
  @@index([dentistId, startsAt])
}

// Evolución clínica. Una vez firmada es inmutable (Res. 1995/1999): las correcciones
// se registran como una nueva evolución que referencia a la anterior.
model Evolution {
  id            String      @id @default(cuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  dentistId     String
  dentist       User        @relation(fields: [dentistId], references: [id])
  reason        String? // motivo de consulta
  diagnosisCode String? // CIE-10
  procedureCode String? // CUPS
  note          String // descripción del procedimiento / evolución
  signedAt      DateTime    @default(now())
  correctsId    String?
  corrects      Evolution?  @relation("Correction", fields: [correctsId], references: [id])
  corrections   Evolution[] @relation("Correction")
  createdAt     DateTime    @default(now())

  @@index([patientId, signedAt])
}

model ToothFinding {
  id        String         @id @default(cuid())
  patientId String
  patient   Patient        @relation(fields: [patientId], references: [id])
  tooth     Int // numeración FDI: 11-18, 21-28, 31-38, 41-48 (51-85 temporales)
  surface   String? // M, D, O, V, L o null = diente completo
  condition ToothCondition
  note      String?
  createdAt DateTime       @default(now())

  @@index([patientId, tooth])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// Valoración clínica (anamnesis + examen). Solo se agregan versiones; la última es la vigente.
model Assessment {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  data      Json
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

model Diagnosis {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])
  dentistId   String
  dentist     User            @relation(fields: [dentistId], references: [id])
  code        String // CIE-10
  description String
  tooth       Int?
  // Si lo propuso el sistema a partir de un hallazgo: clave estable para no duplicar
  sourceKey   String?
  note        String?
  status      DiagnosisStatus @default(ACTIVE)
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([patientId, status])
}

model TreatmentPlan {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])
  dentistId   String
  dentist     User            @relation(fields: [dentistId], references: [id])
  title       String
  status      PlanStatus      @default(DRAFT)
  presentedAt DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime        @default(now())
  items       TreatmentItem[]

  @@index([patientId, status])
}

model TreatmentItem {
  id            String        @id @default(cuid())
  planId        String
  plan          TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  phase         Int // 1 urgencia, 2 control de la enfermedad, 3 rehabilitación, 4 mantenimiento
  tooth         Int?
  surfaces      String?
  procedureCode String? // CUPS, solo si está verificado
  name          String
  quantity      Int           @default(1)
  unitPrice     Int           @default(0) // COP
  status        ItemStatus    @default(PLANNED)
  doneAt        DateTime?
  doneById      String?
  evolutionId   String?
  notes         String?
  sourceKey     String?
  material      String?
  createdAt     DateTime      @default(now())

  @@index([planId, phase])
}

// Consentimiento informado firmado. Inmutable: guarda el texto exacto que se firmó.
model Consent {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  dentistId       String
  dentist         User     @relation(fields: [dentistId], references: [id])
  templateId      String
  templateVersion String
  title           String
  body            String
  procedureNote   String?
  signerName      String
  signerDocument  String?
  signerRelation  String
  witnessName     String?
  signature       String // PNG en data URL
  signedAt        DateTime @default(now())

  @@index([patientId, signedAt])
}

// Foto fija del odontograma (p. ej. el inicial, que no cambia después).
model OdontogramSnapshot {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  kind      String // INITIAL
  data      Json
  createdAt DateTime @default(now())

  @@unique([patientId, kind])
}

// Periodontograma. Solo se agregan versiones; la última es la vigente.
model PerioExam {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  data      Json // por diente: sitios con sondaje, margen, sangrado, placa; movilidad, furca
  summary   Json
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

// Sesión de caja: una abierta a la vez por consultorio.
model CashSession {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  openedById    String
  openedBy      User      @relation(fields: [openedById], references: [id])
  openedAt      DateTime  @default(now())
  openingAmount Int       @default(0)
  closedAt      DateTime?
  closedById    String?
  countedCash   Int?
  expectedCash  Int?
  difference    Int?
  note          String?
  payments      Payment[]

  @@index([clinicId, openedAt])
}

// Pago recibido. Inmutable: los errores se corrigen anulando con motivo.
model Payment {
  id           String      @id @default(cuid())
  clinicId     String
  clinic       Clinic      @relation(fields: [clinicId], references: [id])
  number       Int // consecutivo del recibo por consultorio
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id])
  sessionId    String
  session      CashSession @relation(fields: [sessionId], references: [id])
  amount       Int // COP
  method       PayMethod
  reference    String?
  note         String?
  receivedById String
  receivedBy   User        @relation(fields: [receivedById], references: [id])
  receivedAt   DateTime    @default(now())
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?

  @@unique([clinicId, number])
  @@index([patientId])
  @@index([sessionId])
}

// Intento de recordatorio por WhatsApp. channel: MANUAL (enlace wa.me) o CLOUD (API de Meta).
model Reminder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       String
  status        String // SENT | FAILED
  error         String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

// Radiografía, fotografía o documento clínico. Se guarda en la base de datos para que quede
// dentro de las copias de seguridad; los archivos no se borran, solo se anulan con motivo.
model ClinicalImage {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id])
  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])
  kind            String
  tooth           Int?
  takenAt         DateTime
  note            String?
  fileName        String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  data            Bytes
  thumb           Bytes?
  interpretation  String?
  interpretedById String?
  interpretedAt   DateTime?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime  @default(now())

  @@index([patientId, takenAt])
}

// Cuenta de cobro: documento interno numerado con los procedimientos realizados.
// NO es factura electrónica de venta; esa se emite con un proveedor tecnológico autorizado.
model Invoice {
  id               String        @id @default(cuid())
  clinicId         String
  clinic           Clinic        @relation(fields: [clinicId], references: [id])
  number           Int
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id])
  customerName     String
  customerDocument String?
  issuedAt         DateTime      @default(now())
  total            Int
  note             String?
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id])
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  lines            InvoiceLine[]

  @@unique([clinicId, number])
  @@index([patientId])
}

model InvoiceLine {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Un procedimiento solo puede estar en una cuenta vigente; al anular la cuenta se libera.
  itemId        String? @unique
  description   String
  tooth         Int?
  procedureCode String?
  quantity      Int
  unitPrice     Int
}

// Invitación para unirse a un consultorio. Se guarda solo el hash del enlace.
model Invitation {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  email       String
  role        Role
  tokenHash   String    @unique
  branchIds   String[]
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([clinicId])
}

// Enlace de un solo uso para definir una contraseña nueva.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Sede de un consultorio. Los pacientes son del consultorio; agenda y caja son por sede.
model Branch {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  name         String
  address      String?
  phone        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  users        UserBranch[]
  appointments Appointment[]
  cashSessions CashSession[]

  @@index([clinicId])
}

// Sedes a las que puede entrar una persona (los administradores entran a todas).
model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

// Sugerencias que el odontólogo eliminó: la sincronización automática no las vuelve a agregar.
model DismissedSuggestion {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  key       String
  createdAt DateTime @default(now())

  @@unique([patientId, key])
}
